# Raspberry Pi IoT Control Room Configuration
# Copy this file to .env in the server directory

# Server Network Binding
PORT=3001
HOST=0.0.0.0

# MQTT Broker (Mosquitto running locally on the Raspberry Pi)
MQTT_BROKER_URL=mqtt://localhost:1883

# ESP32-CAM Wireless MJPEG Stream Addresses
# (Connected to the Raspberry Pi Wi-Fi Hotspot)
CAM1_IP=192.168.4.3
CAM1_PORT=81
CAM2_IP=192.168.4.4
CAM2_PORT=81

# Optional Database Config (if logging historical telemetry)
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=iot_dashboard
