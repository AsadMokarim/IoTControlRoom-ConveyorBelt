# Raspberry Pi IoT Control Room Configuration
# Copy this file to .env in the server directory

# Server Network Binding
PORT=3001
HOST=0.0.0.0

# MQTT Broker (Mosquitto running on Raspberry Pi hotspot or localhost)
MQTT_BROKER_URL=mqtt://10.42.0.1:1883
MQTT_CONTROL_TOPIC=conveyor/control

# ESP32-CAM Wireless MJPEG Stream Addresses
# (Connected to the Raspberry Pi Wi-Fi Hotspot)
ESP32_CAM_STREAM_URL=http://10.42.0.118:81/stream
CAM1_IP=10.42.0.118
CAM1_PORT=81
CAM2_IP=192.168.4.4
CAM2_PORT=81

# Optional Database Config (if logging historical telemetry)
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=iot_dashboard
